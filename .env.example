# Copy to `.env` next to docker-compose.yml and fill in. Never commit `.env`.

# Host port for the whole site (website, /cafe/ menu, /api/).
PORT=8080

# Base URL that printed QR codes point at — must end in /cafe.
# Local phones on Wi-Fi: http://<laptop-LAN-IP>:8080/cafe
PUBLIC_BASE_URL=http://localhost:8080/cafe

# Razorpay keys — https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Password for /cafe/admin. Required; compose refuses to start without it.
ADMIN_PASSWORD=

# Telegram notifications (optional; leave the token empty to turn them off).
# 1. Create a bot with @BotFather and paste its token here.
# 2. Each person sends the bot any message, then opens
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copies "chat":{"id":...}.
TELEGRAM_BOT_TOKEN=
# Nightly summary of both properties
TELEGRAM_OWNER_CHAT_ID=
# Evening reminder to each property's manager when expenses or stock aren't logged
TELEGRAM_CHAT_SHOJA=
TELEGRAM_CHAT_KASOL=
# India time
REMINDER_AT=21:00
SUMMARY_AT=22:30

# Self check-in: delete guests' ID photos this many days after check-out
ID_RETENTION_DAYS=365
